# Remote access configuration for the live Jetson system.
# Copy this file to scripts/remote/remote.env (gitignored) and fill in real values.

# SSH target (host alias, hostname, or user@host). Key-based auth must already work:
# scripts never prompt for a password (BatchMode=yes).
JETSON_HOST=user@jetson.local

# Absolute project directory on the Jetson (code + venv + data live here)
REMOTE_PROJECT_DIR=/home/user/home-person-id

# The following have sensible defaults (relative to REMOTE_PROJECT_DIR) — override only if needed:
#REMOTE_DB=data/database.db
#REMOTE_LOG=data/app.log          # rotated app log (RotatingFileHandler)
#REMOTE_STDOUT_LOG=data/stdout.log # raw stdout/stderr of detached runs (perf reports, tracebacks)
#LOCAL_PULL_DIR=local/remote      # where pulled data lands on the dev machine (local/ is gitignored)
#REMOTE_APP_ARGS="--perf-report"  # extra args restart.sh passes to `python -m src.main`
